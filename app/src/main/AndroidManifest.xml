<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LocalAiStudio"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".ChatActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:parentActivityName=".ChatActivity" />

        <activity
            android:name=".ModelsActivity"
            android:exported="false"
            android:label="@string/models_title"
            android:parentActivityName=".ChatActivity" />

        <activity
            android:name=".GenerationSettingsActivity"
            android:exported="false"
            android:label="@string/settings_generation_header"
            android:parentActivityName=".SettingsActivity" />

        <activity
            android:name=".FilesActivity"
            android:exported="false"
            android:label="@string/menu_files"
            android:parentActivityName=".ChatActivity" />

        <activity
            android:name=".HistoryActivity"
            android:exported="false"
            android:label="@string/menu_history"
            android:parentActivityName=".ChatActivity" />

        <activity
            android:name=".ApiKeysActivity"
            android:exported="false"
            android:label="@string/settings_api_keys_manage"
            android:parentActivityName=".SettingsActivity" />

        <activity
            android:name=".LogActivity"
            android:exported="false"
            android:label="@string/settings_log"
            android:parentActivityName=".SettingsActivity" />

        <service
            android:name=".models.ModelDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>

</manifest>
