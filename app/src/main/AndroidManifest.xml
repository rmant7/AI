<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.LocalAiStudio"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".ChatActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:parentActivityName=".ChatActivity" />

        <activity
            android:name=".ModelsActivity"
            android:exported="false"
            android:label="@string/models_title"
            android:parentActivityName=".ChatActivity" />

        <activity
            android:name=".ExperimentalEmbeddingsActivity"
            android:exported="false"
            android:label="@string/embed_screen_title"
            android:parentActivityName=".SettingsActivity" />

        <activity
            android:name=".AiCoreTestActivity"
            android:exported="false"
            android:label="@string/aicore_screen_title"
            android:parentActivityName=".SettingsActivity" />

        <activity
            android:name=".GenerationSettingsActivity"
            android:exported="false"
            android:label="@string/settings_generation_header"
            android:parentActivityName=".SettingsActivity" />

        <activity
            android:name=".FilesActivity"
            android:exported="false"
            android:label="@string/menu_files"
            android:parentActivityName=".ChatActivity" />

        <activity
            android:name=".HistoryActivity"
            android:exported="false"
            android:label="@string/menu_history"
            android:parentActivityName=".ChatActivity" />

        <activity
            android:name=".MemoryActivity"
            android:exported="false"
            android:label="@string/memory_title"
            android:parentActivityName=".ChatActivity" />

        <activity
            android:name=".ApiKeysActivity"
            android:exported="false"
            android:label="@string/settings_api_keys_manage"
            android:parentActivityName=".SettingsActivity" />

        <activity
            android:name=".LogActivity"
            android:exported="false"
            android:label="@string/settings_log"
            android:parentActivityName=".ChatActivity" />

        <activity
            android:name=".TranscribeActivity"
            android:exported="false"
            android:label="@string/menu_transcribe"
            android:parentActivityName=".ChatActivity" />

        <activity
            android:name=".BenchmarkActivity"
            android:exported="false"
            android:label="@string/menu_benchmark"
            android:parentActivityName=".ChatActivity" />

        <activity
            android:name=".TranslationActivity"
            android:exported="false"
            android:label="@string/menu_translation"
            android:parentActivityName=".ChatActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".PhrasebookActivity"
            android:exported="false"
            android:label="@string/menu_phrasebook"
            android:parentActivityName=".ChatActivity" />

        <service
            android:name=".models.ModelDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".whisper.FileTranscriptionService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".benchmark.BenchmarkService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Exposes only files/transcripts/ (see xml/transcript_file_paths.xml)
             as content:// URIs — TranscribeActivity's saved .txt transcripts
             live under this app's own private filesDir, unreachable by any
             other app (a file manager, Drive, Telegram) without this: a
             plain file:// URI is blocked by StrictMode for cross-app
             sharing on modern Android, and text-only Intent.EXTRA_TEXT
             shares content, not a file the user can actually save. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/transcript_file_paths" />
        </provider>

    </application>

</manifest>
