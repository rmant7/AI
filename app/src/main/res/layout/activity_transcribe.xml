<?xml version="1.0" encoding="utf-8"?>
<!-- The whole screen scrolls as one unit: transcribeResults used to be the
     only flexible-height child (layout_weight="1") in a non-scrolling,
     match_parent LinearLayout, on the assumption that whatever sat below it
     (the mic sections) would always fit in whatever space was left over.
     Adding the router section (a third mic block) broke that assumption —
     on a real device, content below the fold was simply unreachable, no
     scrolling, nothing clipped-but-visible-via-gesture. transcribeResults
     itself switches to wrap_content + nested scrolling disabled below, so
     this single ScrollView is the only thing that scrolls. Plain framework
     ScrollView, not androidx's NestedScrollView: nothing below actually
     needs nested-scroll cooperation once transcribeResults' own nested
     scrolling is disabled, so there is no reason to pull in the androidx
     widget. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/transcribeHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceVariant"
        android:padding="16dp"
        android:text="@string/transcribe_hint"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pickFileButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="@string/transcribe_pick_file" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pickFolderButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="@string/transcribe_pick_folder" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/openVoiceModelsButton"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="4dp"
        android:text="@string/transcribe_open_voice_models" />

    <TextView
        android:id="@+id/transcribeSourceText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp"
        android:textSize="13sp" />

    <!-- A single shared player, next to the source picker rather than one
         per result row: only one file plays at a time (one MediaPlayer),
         so a real seek bar/position belongs to one control, not duplicated
         per row and disconnected from transcription. Tap a result row to
         load it here (see TranscribeActivity.selectAndPlay). Hidden until
         something is actually loaded. -->
    <LinearLayout
        android:id="@+id/playerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceVariant"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/playerPlayPauseButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/transcribe_play"
            android:padding="6dp"
            android:src="@drawable/ic_play_arrow"
            app:tint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/playerFileNameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="middle"
            android:maxWidth="120dp"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/playerSeekBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/playerTimeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingBottom="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/transcribeStartButton"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:enabled="false"
            android:text="@string/transcribe_start" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/transcribeStopButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:enabled="false"
            android:text="@string/transcribe_stop" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/transcribeProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone" />

    <TextView
        android:id="@+id/transcribeEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="@string/transcribe_empty" />

    <!-- File-transcription results: kept directly below the controls that
         produce them (source picker, Start/Stop) with nothing else between,
         so a result stays visually attached to the file it belongs to
         instead of being split across the mic test section below. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/transcribeResults"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp" />

    <!-- Phase 3 test harness (docs/13-asr-pipeline-migration.md): drives
         WhisperCppMicSession/MicrophoneAudioSource directly, independent of
         the file/folder batch controls above. Does not touch ChatActivity's
         own (currently hidden) mic button or WhisperEngine at all. Kept
         last so it never wedges itself between the file picker and its own
         results above. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:text="@string/transcribe_mic_section_title"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="11sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/micToggleButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/transcribe_mic_start" />

        <TextView
            android:id="@+id/micStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- No maxHeight/scrollbars: this whole screen is one ScrollView now
         (see the root element's own comment) — a bounded box with its own
         ScrollingMovementMethod nested inside an outer scrolling container
         is a well-known Android gesture conflict (the outer ScrollView
         wins the drag, so content past the inner box's height becomes
         unreachable) — simply growing to wrap_content and letting the
         single outer ScrollView handle it avoids that entirely. -->
    <TextView
        android:id="@+id/micTranscriptText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingBottom="10dp"
        android:textIsSelectable="true"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Vosk ASR spike (docs/14-vosk-spike.md): a second, independent live
         mic section, driving VoskSpeechRecognizer directly. Deliberately
         separate from the Whisper LIVE MIC section above rather than a
         shared toggle — this way trying Vosk can never regress the
         already-working Whisper mic path above it. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:text="@string/transcribe_vosk_section_title"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="11sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/voskToggleButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/transcribe_mic_start" />

        <TextView
            android:id="@+id/voskStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/voskTranscriptText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingBottom="10dp"
        android:textIsSelectable="true"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- docs/15-speech-routing.md: the experimental language-routed live
         mic — dispatches per detected language to whichever registered
         specialist (Vosk RU/EN) or the Whisper fallback the router
         chooses, instead of driving one fixed engine directly like the
         two sections above. Each line is tagged [lang][modelId] so a
         routing decision is visible, not just its output. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:text="@string/transcribe_router_section_title"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="11sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/routerToggleButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/transcribe_mic_start" />

        <TextView
            android:id="@+id/routerStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/routerTranscriptText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingBottom="10dp"
        android:textIsSelectable="true"
        android:textSize="13sp"
        android:visibility="gone" />

</LinearLayout>

</ScrollView>
