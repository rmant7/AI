<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/deviceText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceVariant"
        android:padding="16dp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12sp" />

    <!-- Task-type switcher, the way Edge Studio groups its catalog: one
         capability per tab. Image and Agents are the reason this is a
         toggle group and not a hardcoded pair of buttons — a third/fourth
         entry is one more button, not a restructure — [Category.EMBEDDING]
         is the first of those. -->
    <!-- Voice category was hidden alongside the mic button in
         activity_chat.xml (voice input quality wasn't ready to ship) — but
         file transcription (TranscribeActivity, docs/13-asr-pipeline-migration.md)
         needs this tab to pick/download a model, independent of whether mic
         input is enabled. Un-hidden for that; the mic button itself is
         unaffected and stays as it was. -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/categoryToggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:checkedButton="@id/categoryText"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/categoryText"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/models_category_text" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/categoryVoice"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/models_category_voice" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/categoryEmbedding"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/models_category_embedding" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/categoryTranslation"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/models_category_translation" />

    </com.google.android.material.button.MaterialButtonToggleGroup>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/models"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="12dp" />

</LinearLayout>
