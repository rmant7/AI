<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="4dp">

    <LinearLayout
        android:id="@+id/bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:maxWidth="300dp"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="true">

            <TextView
                android:id="@+id/roleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.7"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/timeText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:alpha="0.55"
                android:gravity="end"
                android:paddingStart="12dp"
                android:paddingEnd="0dp"
                android:textSize="11sp" />

        </LinearLayout>

        <!--
            Above the text, matching how every ordinary chat app shows an
            attachment: the picture the turn is about, then whatever was
            typed alongside it. Hidden by default — most messages carry no
            image at all, and re-showing a stale one from a recycled view
            without this default is exactly how a bound-but-forgotten
            ImageView leaks the previous row's picture onto this one.
        -->
        <ImageView
            android:id="@+id/messageImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginTop="6dp"
            android:adjustViewBounds="true"
            android:maxWidth="260dp"
            android:maxHeight="260dp"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:contentDescription="@string/message_attached_image" />

        <TextView
            android:id="@+id/bodyText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="2dp"
            android:textIsSelectable="true"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/detailsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:textSize="11sp"
            android:alpha="0.7"
            android:visibility="gone" />

        <!--
            Below the text, not up in the header row with the role and time:
            copying is something you reach for after reading an answer, and
            every other chat app puts it at the end of the message for that
            reason. End-aligned so it lands under the message's trailing edge
            rather than floating in the middle of a short bubble.
        -->
        <ImageButton
            android:id="@+id/copyButton"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="end"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="-4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/message_copy"
            android:padding="5dp"
            android:src="@drawable/ic_copy" />

    </LinearLayout>

</FrameLayout>
