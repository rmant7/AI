<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/benchmarkHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurfaceVariant"
            android:padding="16dp"
            android:text="@string/benchmark_hint"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/benchmarkPickFolderButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:text="@string/benchmark_pick_folder" />

        <TextView
            android:id="@+id/benchmarkSourceText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingBottom="8dp"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="16dp"
            android:text="@string/benchmark_mode_label"
            android:textSize="12sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/benchmarkModeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <RadioButton
                android:id="@+id/benchmarkModeMaximum"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="@string/benchmark_mode_maximum"
                android:textSize="12sp" />

            <RadioButton
                android:id="@+id/benchmarkModeSustained"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/benchmark_mode_sustained"
                android:textSize="12sp" />

            <RadioButton
                android:id="@+id/benchmarkModeCoolDown"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/benchmark_mode_cool_down"
                android:textSize="12sp" />

        </RadioGroup>

        <TextView
            android:id="@+id/benchmarkSustainedHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingTop="4dp"
            android:textColor="?attr/colorError"
            android:textSize="11sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/benchmarkStartButton"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:enabled="false"
            android:text="@string/benchmark_start" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/benchmarkCancelButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:enabled="false"
            android:text="@string/benchmark_cancel" />

        <ProgressBar
            android:id="@+id/benchmarkProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/benchmarkStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:textSize="13sp" />

        <!-- One row per engine, added programmatically (see
             BenchmarkActivity.renderSummary) — a RecyclerView would be
             overkill for what is, at least for now, a handful of rows;
             a plain table keeps this screen's own UI as simple as the
             task explicitly asked for. -->
        <TableLayout
            android:id="@+id/benchmarkSummaryTable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:stretchColumns="*"
            android:visibility="gone" />

        <TextView
            android:id="@+id/benchmarkTrendText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingBottom="8dp"
            android:textSize="12sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/benchmarkShareButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:text="@string/transcribe_share"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>
