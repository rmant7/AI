<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!--
            Real device report: the CPU-feature line this header grew
            (NEON/DOTPROD/MATMUL_INT8/...) made it, pinned outside this
            ScrollView, tall enough on its own to cover more than half the
            screen on a real device — worse the longer a future addition
            makes it. Scrolling with the log itself (one TextView still
            selects the header and the log as one contiguous block, matching
            how it's meant to be copied — see logCopyButton below) means its
            height is never a problem again, whatever it grows to.
            -->
            <TextView
                android:id="@+id/logHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/colorSurfaceVariant"
                android:fontFamily="monospace"
                android:paddingHorizontal="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="8dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textIsSelectable="true"
                android:textSize="11sp"
                tools:text="Version: 1.2.3 (code 45) · Commit: a1b2c3d · CI build: 166" />

            <TextView
                android:id="@+id/logHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/colorSurfaceVariant"
                android:paddingHorizontal="16dp"
                android:paddingBottom="16dp"
                android:text="@string/log_hint"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/logText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:fontFamily="monospace"
                android:textIsSelectable="true"
                android:textSize="11sp" />

        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/logClearButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/log_clear" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/logCopyButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/log_copy" />

    </LinearLayout>

</LinearLayout>
